<<< {"jsonrpc":"2.0","id":9,"result":{"content":[{"text":"{\n  \"family\": \"power\",\n  \"loaded_under_active_profile\": false,\n  \"schema_version\": \"v0.6.4-family-schemas-1\",\n  \"tools\": [\n    {\n      \"description\": \"Pillar 2 / Stream D — pre-write near-duplicate check. Embeds `title + content`, scans live memories with stored embeddings (optionally restricted to `namespace`), and returns the highest-cosine match. `is_duplicate` is `nearest.similarity >= threshold`; the response also surfaces `suggested_merge` (the nearest memory's id) when the threshold is met. Threshold is clamped to a hard floor of 0.5 so permissive callers can't dress unrelated content as a merge candidate. Requires the embedder to be loaded (semantic tier or above).\",\n      \"inputSchema\": {\n        \"properties\": {\n          \"content\": {\n            \"description\": \"Content of the candidate memory.\",\n            \"type\": \"string\"\n          },\n          \"namespace\": {\n            \"description\": \"Restrict the duplicate scan to this namespace. Omit to scan all namespaces.\",\n            \"type\": \"string\"\n          },\n          \"threshold\": {\n            \"default\": 0.85,\n            \"description\": \"Cosine similarity threshold for declaring a duplicate. Clamped to >= 0.5. Default 0.85 is tuned for MiniLM-L6-v2 — near-paraphrases land at 0.88+.\",\n            \"maximum\": 1.0,\n            \"minimum\": 0.5,\n            \"type\": \"number\"\n          },\n          \"title\": {\n            \"description\": \"Title of the candidate memory. Combined with `content` to form the embedding input, matching memory_store's encoding.\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"title\",\n          \"content\"\n        ],\n        \"type\": \"object\"\n      },\n      \"name\": \"memory_check_duplicate\"\n    },\n    {\n      \"description\": \"Consolidate multiple memories into one long-term summary. Deletes source memories and creates derived_from links. If summary is omitted and LLM is available (smart/autonomous tier), auto-generates a summary.\",\n      \"inputSchema\": {\n        \"properties\": {\n          \"ids\": {\n            \"description\": \"Memory IDs to consolidate (minimum 2, maximum 100)\",\n            \"items\": {\n              \"type\": \"string\"\n            },\n            \"maxItems\": 100,\n            \"minItems\": 2,\n            \"type\": \"array\"\n          },\n          \"namespace\": {\n            \"default\": \"global\",\n            \"type\": \"string\"\n          },\n          \"summary\": {\n            \"description\": \"Summary content (optional — auto-generated via LLM if omitted at smart/autonomous tier)\",\n            \"type\": \"string\"\n          },\n          \"title\": {\n            \"description\": \"Title for the consolidated memory\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"ids\",\n          \"title\"\n        ],\n        \"type\": \"object\"\n      },\n      \"name\": \"memory_consolidate\"\n    },\n    {\n      \"description\": \"Use LLM to expand a search query into additional semantically related terms. Requires smart or autonomous tier.\",\n      \"inputSchema\": {\n        \"properties\": {\n          \"query\": {\n            \"description\": \"The search query to expand\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"query\"\n        ],\n        \"type\": \"object\"\n      },\n      \"name\": \"memory_expand_query\"\n    },\n    {\n      \"description\": \"Use LLM to auto-generate tags for a memory. Requires smart or autonomous tier.\",\n      \"inputSchema\": {\n        \"properties\": {\n          \"id\": {\n            \"description\": \"Memory ID to auto-tag\",\n            \"type\": \"string\"\n          }\n        },\n        \"required\": [\n          \"id\"\n        ],\n        \"type\":