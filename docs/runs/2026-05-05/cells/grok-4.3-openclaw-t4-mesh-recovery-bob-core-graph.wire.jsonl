<<< {"jsonrpc":"2.0","id":2,"result":{"tools":[{"description":"Store a new memory. Deduplicates by title+namespace.","inputSchema":{"properties":{"agent_id":{"description":"Agent identifier. If omitted, the server synthesizes an NHI-hardened default (ai:<client>@<host>:pid-<pid>, host:<host>:pid-<pid>-<uuid8>, or anonymous:pid-<pid>-<uuid8>).","type":"string"},"confidence":{"default":1.0,"maximum":1.0,"minimum":0.0,"type":"number"},"content":{"description":"Full memory content","type":"string"},"metadata":{"default":{},"description":"Arbitrary JSON metadata","type":"object"},"namespace":{"description":"Project/topic namespace","type":"string"},"on_conflict":{"description":"v0.6.3.1 P2 (G6) — collision policy when (title, namespace) already exists. 'error' returns CONFLICT (default for v2-capable clients). 'merge' updates the existing row in place (legacy v0.6.3 behaviour, default for v1 clients). 'version' appends a monotonic suffix to the title — 'My Memory (2)', '(3)', ...","enum":["error","merge","version"],"type":"string"},"priority":{"default":5,"maximum":10,"minimum":1,"type":"integer"},"scope":{"description":"Task 1.5 visibility scope. Defaults to private when unset. Stored as metadata.scope.","enum":["private","team","unit","org","collective"],"type":"string"},"source":{"default":"claude","enum":["user","claude","hook","api","cli","import","consolidation","system","chaos"],"type":"string"},"tags":{"default":[],"items":{"type":"string"},"type":"array"},"tier":{"default":"mid","enum":["short","mid","long"],"type":"string"},"title":{"description":"Short descriptive title","type":"string"}},"required":["title","content"],"type":"object"},"name":"memory_store"},{"description":"Recall memories relevant to a context. Uses fuzzy OR matching, ranks by relevance + priority + access frequency + tier.","inputSchema":{"properties":{"as_agent":{"description":"Querying agent's namespace position (Task 1.5). Enables scope-based visibility filtering — results include private memories at this namespace, team/unit/org memories at ancestor subtrees, and collective memories globally.","type":"string"},"budget_tokens":{"description":"Phase P6 (R1) — context-budget-aware recall. Return the highest-ranked memories whose cumulative content tokens (deterministic cl100k_base BPE; matches Claude/GPT context accounting) fit in N. If the top-ranked memory alone exceeds the budget, it is returned anyway with meta.budget_overflow=true (R1 always-return-at-least-one guarantee). budget_tokens=0 returns zero memories with overflow=false. Response meta block: budget_tokens_used, budget_tokens_remaining, memories_dropped, budget_overflow.","minimum":0,"type":"integer"},"context":{"description":"What you're trying to remember","type":"string"},"context_tokens":{"description":"v0.6.0.0 contextual recall — recent conversation tokens used to bias the query embedding at 70/30 (primary/context). Pulls results toward memories that match both the explicit query and nearby conversation topics.","items":{"type":"string"},"type":"array"},"format":{"default":"toon_compact","description":"Response format. Default 'toon_compact' saves 79% tokens vs JSON. 'toon' includes timestamps. 'json' for structured parsing.","enum":["json","toon","toon_compact"],"type":"string"},"limit":{"default":10,"maximum":50,"type":"integer"},"namespace":{"description":"Filter by namespace","type":"string"},"since":{"description":"Only memories created after this RFC3339 timestamp","type":"string"},"tags":{"description":"Filter by tag","type":"string"},"until":{"description":"Only memories created before this RFC3339 timestamp","type":"string"}},"required":["context"],"type":"object"},"name":"memory_recall"},{"description":"Search memories by exact keyword match (AND semantics).","inputSchema":{"properties":{"agent_id":{"description":"Filter by metadata.agent_id (exact match).","type":"string"},"as_agent":{"description":"Querying agent's namespace position (Task 1.5) for scope-based visibility filtering.","type":"string"},"format":{"default":"toon_compact","description":"Response format. Default 'toon_compact' saves 79% tokens. 'json' for structured parsing.","enum":["json","toon","toon_compact"],"type":"string"},"limit":{"default":20,"maximum":200,"type":"integer"},"namespace":{"type":"string"},"query":{"type":"string"},"tier":{"enum":["short","mid","long"],"type":"string"}},"required":["query"],"type":"object"},"name":"memory_search"},{"description":"List memories, optionally filtered by namespace or tier.","inputSchema":{"properties":{"agent_id":{"description":"Filter by metadata.agent_id (exact match).","type":"string"},"format":{"default":"toon_compact","description":"Response format. Default 'toon_compact' saves 79% tokens. 'json' for structured parsing.","enum":["json","toon","toon_compact"],"type":"string"},"limit":{"default":20,"maximum":200,"type":"integer"},"namespace":{"type":"string"},"tier":{"enum":["short","mid","long"],"type":"string"}},"type":"object"},"name":"memory_list"},{"description":"Pillar 1 / Stream A — return a hierarchical tree of namespaces with memory counts. Walks the `/`-delimited namespace paths grouped from live memories (expired rows excluded). Each node carries `count` (memories at exactly that namespace) and `subtree_count` (count plus all descendants visible within `depth`); the response also exposes `total_count` for the prefix and a `truncated` flag set when `limit` forced rows to be dropped from the tree.","inputSchema":{"properties":{"depth":{"default":8,"description":"Max levels to descend below the prefix. Memories deeper than this still contribute to `subtree_count` of the boundary ancestor.","maximum":8,"minimum":0,"type":"integer"},"limit":{"default":1000,"description":"Cap on `(namespace, count)` rows walked when assembling the tree. Densest namespaces win when truncated.","maximum":10000,"minimum":1,"type":"integer"},"namespace_prefix":{"description":"Restrict the tree to memories at this namespace OR any descendant. Omit to walk the full tree. Trailing '/' is tolerated.","type":"string"}},"type":"object"},"name":"memory_get_taxonomy"},{"description":"Pillar 2 / Stream B — register an entity (canonical name + aliases) under a namespace. Entities are stored as long-tier memories tagged 'entity' with metadata.kind='entity', so the (title, namespace) coordinate is shared with regular memories without ambiguity. Idempotent: re-registering the same canonical_name+namespace reuses the existing entity_id and merges any new aliases. Errors when the namespace+canonical_name already names a non-entity memory.","inputSchema":{"properties":{"agent_id":{"description":"Override the caller's resolved NHI for the entity memory's metadata.agent_id.","type":"string"},"aliases":{"description":"Aliases that should resolve to this entity. Blank entries are skipped; duplicates are de-duped via the entity_aliases primary key.","items":{"type":"string"},"type":"array"},"canonical_name":{"description":"Display name for the entity. Stored as the entity memory's title.","type":"string"},"metadata":{"description":"Arbitrary metadata to attach to the entity memory. Caller-supplied 'kind' is overwritten with 'entity'; agent_id is stamped from the NHI caller when not specified.","type":"object"},"namespace":{"description":"Namespace under which the entity lives. Hierarchy paths (e.g. 'projects/alpha') are accepted.","type":"string"}},"required":["canonical_name","namespace"],"type":"object"},"name":"memory_entity_register"},{"description":"Pillar 2 / Stream B — resolve an alias to its registered entity. When 'namespace' is provided, only entities in that namespace are returned. When omitted, the most recently created matching entity wins. Returns null when no entity claims the alias under the given filter.","inputSchema":{"properties":{"alias":{"description":"Alias string to resolve. Whitespace is trimmed.","type":"string"},"namespace":{"description":"Restrict the resolution to this namespace. Omit to search all namespaces.","type":"string"}},"required":["alias"],"type":"object"},"name":"memory_entity_get_by_alias"},{"description":"Pillar 2 / Stream C — ordered fact timeline for an entity. Returns outbound links from `source_id` (e.g. an entity registered via memory_entity_register) with their temporal-validity columns (valid_from, valid_until, observed_by) and the target memory's title/namespace. Events are ordered by valid_from ASC; rows with NULL valid_from are excluded. Cross-namespace by design — callers can post-filter by target_namespace if needed.","inputSchema":{"properties":{"limit":{"default":200,"description":"Max events returned. Clamped to [1, 1000].","maximum":1000,"minimum":1,"type":"integer"},"since":{"description":"RFC3339 timestamp; events with valid_from earlier than this are excluded (inclusive boundary).","type":"string"},"source_id":{"description":"Memory ID whose outbound assertions form the timeline. Typically an entity_id from memory_entity_register, but any memory works.","type":"string"},"until":{"description":"RFC3339 timestamp; events with valid_from later than this are excluded (inclusive boundary).","type":"string"}},"required":["source_id"],"type":"object"},"name":"memory_kg_timeline"},{"description":"Pillar 2 / Stream C — mark a KG link as superseded by setting its `valid_until` column. The link is identified by the (source_id, target_id, relation) triple (memory_links has no separate id column). When `valid_until` is omitted, the current wall-clock time is used. Idempotent: repeated calls overwrite the prior value and the response reports `previous_valid_until` so callers can detect the overwrite. Returns `found: false` when no link matches the triple.","inputSchema":{"properties":{"relation":{"description":"Relation label of the link (e.g. 'related_to', 'supersedes', 'derived_from'). Must be a recognized relation.","type":"string"},"source_id":{"description":"Source memory ID of the link to invalidate.","type":"string"},"target_id":{"description":"Target memory ID of the link to invalidate.","type":"string"},"valid_until":{"description":"RFC3339 timestamp marking when the assertion stops being valid. Defaults to the current time when omitted.","type":"string"}},"required":["source_id","target_id","relation"],"type":"object"},"name":"memory_kg_invalidate"},{"description":"Pillar 2 / Stream C — outbound KG traversal from a source memory. Returns one node per link reachable from `source_id` within `max_depth` hops, with the link's temporal-validity columns (valid_from, valid_until, observed_by) and the target memory's title/namespace. Multi-hop traversal uses a recursive CTE with cycle detection — chains only extend through links that pass every filter on every hop. Filters: `valid_at` keeps only links valid at that instant; `allowed_agents` keeps only links observed by an agent in the set (empty list returns zero rows by design — empty allowlist means 'no agents are trusted'). Ordered by depth ASC, then COALESCE(valid_from, created_at) ASC, for stable shallow-first display. `max_depth` ceiling is 5 (matches the published performance budget); larger values return an explicit error.","inputSchema":{"properties":{"allowed_agents":{"description":"If provided, only links whose observed_by is in this set are returned. An empty array returns zero rows. Omit to skip the agent filter.","items":{"type":"string"},"type":"array"},"limit":{"default":200,"description":"Max nodes returned across all depths. Clamped to [1, 1000].","maximum":1000,"minimum":1,"type":"integer"},"max_depth":{"default":1,"description":"Hops from the source. Supported range: 1..=5 (matches the published performance budget for `memory_kg_query`). Larger values return an explicit error.","maximum":5,"minimum":1,"type":"integer"},"source_id":{"description":"Memory ID whose outbound links form the traversal frontier. Typically an entity_id from memory_entity_register, but any memory works.","type":"string"},"valid_at":{"description":"RFC3339 timestamp; only links valid at this instant (valid_from <= valid_at AND (valid_until IS NULL OR valid_until > valid_at)) are returned. Omit to skip the temporal filter (NULL valid_from rows are then included).","type":"string"}},"required":["source_id"],"type":"object"},"name":"memory_kg_query"},{"description":"Get a specific memory by ID, including its links.","inputSchema":{"properties":{"id":{"description":"Memory ID to retrieve","type":"string"}},"required":["id"],"type":"object"},"name":"memory_get"},{"description":"Create a link between two memories.","inputSchema":{"properties":{"relation":{"default":"related_to","enum":["related_to","supersedes","contradicts","derived_from"],"type":"string"},"source_id":{"description":"Source memory ID","type":"string"},"target_id":{"description":"Target memory ID","type":"string"}},"required":["source_id","target_id"],"type":"object"},"name":"memory_link"},{"description":"Get all links for a memory (both directions).","inputSchema":{"properties":{"id":{"description":"Memory ID to get links for","type":"string"}},"required":["id"],"type":"object"},"name":"memory_get_links"},{"description":"Report the active feature tier, loaded models, and available capabilities of the memory system. Returns capabilities schema v2 by default (recommended). Pass accept=\"v1\" for the legacy shape used before v0.6.3.1. v0.6.4 — pass family=<name> to enumerate that family's tools; add include_schema=true to retrieve full schemas inline (NHI runtime-expansion path).","inputSchema":{"properties":{"accept":{"default":"v2","description":"Capabilities-schema version. v2 is the honest, runtime-overlaid shape (default). v1 returns the legacy pre-v0.6.3.1 shape for backward compat.","enum":["v1","v2"],"type":"string"},"family":{"description":"v0.6.4 — when set, returns the tool list (or full schemas with include_schema=true) for that family instead of the global capabilities document. Used by NHI agents to opt into a tool family at runtime without restarting the MCP server.","enum":["core","lifecycle","graph","governance","power","meta","archive","other"],"type":"string"},"include_schema":{"default":false,"description":"v0.6.4 — when true, return full MCP-style tool definitions for each tool in the requested family. Requires family=<name>.","type":"boolean"}},"type":"object"},"name":"memory_capabilities"}],"toolsVersion":"2026-04-26"}}
