y filtering.","type":"string"},"format":{"default":"toon_compact","description":"Response format. Default 'toon_compact' saves 79% tokens. 'json' for structured parsing.","enum":["json","toon","toon_compact"],"type":"string"},"limit":{"default":20,"maximum":200,"type":"integer"},"namespace":{"type":"string"},"query":{"type":"string"},"tier":{"enum":["short","mid","long"],"type":"string"}},"required":["query"],"type":"object"},"name":"memory_search"},{"description":"List memories, optionally filtered by namespace or tier.","inputSchema":{"properties":{"agent_id":{"description":"Filter by metadata.agent_id (exact match).","type":"string"},"format":{"default":"toon_compact","description":"Response format. Default 'toon_compact' saves 79% tokens. 'json' for structured parsing.","enum":["json","toon","toon_compact"],"type":"string"},"limit":{"default":20,"maximum":200,"type":"integer"},"namespace":{"type":"string"},"tier":{"enum":["short","mid","long"],"type":"string"}},"type":"object"},"name":"memory_list"},{"description":"Get a specific memory by ID, including its links.","inputSchema":{"properties":{"id":{"description":"Memory ID to retrieve","type":"string"}},"required":["id"],"type":"object"},"name":"memory_get"},{"description":"Report the active feature tier, loaded models, and available capabilities of the memory system. Returns capabilities schema v2 by default (recommended). Pass accept=\"v1\" for the legacy shape used before v0.6.3.1. v0.6.4 — pass family=<name> to enumerate that family's tools; add include_schema=true to retrieve full schemas inline (NHI runtime-expansion path).","inputSchema":{"properties":{"accept":{"default":"v2","description":"Capabilities-schema version. v2 is the honest, runtime-overlaid shape (default). v1 returns the legacy pre-v0.6.3.1 shape for backward compat.","enum":["v1","v2"],"type":"string"},"family":{"description":"v0.6.4 — when set, returns the tool list (or full schemas with include_schema=true) for that family instead of th